GROQ_API_KEY=your_groq_api_key_here

# Per-request timeout for Groq API calls, in seconds (default 30)
GROQ_TIMEOUT_SECONDS=30

# Local dev default; docker-compose overrides this to sqlite:///./data/mandi.db
# so the DB file lands inside the persisted ./data volume
DATABASE_URL=sqlite:///./mandi.db

# Allowed CORS origins – JSON array syntax, NOT comma-separated.
# Add local dev origins (e.g. "http://localhost:5173") if you run the
# frontend dev server against this API.
CORS_ORIGINS=["https://ai-mandi-advisor.vercel.app"]
